head(bike_sharing)
sample_size = floor(0.8 * nrow(bike_sharing))
indices = sample(seq_len(nrow(bike_sharing)), size = sample_size)
bike_sharing_trn = bike_sharing[indices,]
bike_sharing_tst = bike_sharing[-indices,]
adj_r_squared <- c()
max_vif <- c()
