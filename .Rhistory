bike_sharing_tst_transformed$log_hum <- log(bike_sharing_tst_transformed$hum)
bike_sharing_tst_transformed$log_windspeed <- log(bike_sharing_tst_transformed$windspeed)
names(bike_sharing_trn_transformed)
